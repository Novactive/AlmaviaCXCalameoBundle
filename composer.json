{
  "name": "almaviacx/calameobundle",
  "description": "AlmaviaCX Calaméo Bundle provide a client for the Rest API and a new field type for Ibexa.",
  "keywords": [
    "calameo",
    "ibexa",
    "almaviacx"
  ],
  "homepage": "https://github.com/Novactive/AlmaviaCXCalameoBundle",
  "type": "ibexa-bundle",
  "authors": [
    {
      "name": "AlmaviaCX",
      "homepage": "https://almaviacx.com/",
      "email": "dir.tech@almaviacx.com"
    }
  ],
  "license": [
    "MIT"
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "guzzlehttp/guzzle": "^7.10",
    "guzzlehttp/promises": "^2.3",
    "ibexa/oss": "^5",
    "jms/serializer-bundle": "^5.5",
    "nyholm/psr7": "^1.8",
    "symfony/var-exporter": "|^6.0|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "AlmaviaCX\\Calameo\\": "src/lib",
      "AlmaviaCX\\Calameo\\Tests\\": "tests/Tests",
      "AlmaviaCX\\Bundle\\Calameo\\": "src/bundles"
    }
  },
  "extra": {
    "thanks": {
      "name": "ezsystems/ezplatform",
      "url": "https://github.com/ezsystems/ezplatform"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "ibexa/post-install": true
    }
  }
}
